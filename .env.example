# Salin file ini menjadi ".env" (tanpa "example") lalu isi key aslimu.
# JANGAN pernah commit file .env — sudah masuk .gitignore.
# Contoh: YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_API_KEY=

# API key Groq (gratis, daftar di https://console.groq.com) untuk ringkasan AI.
# Tanpa key ini, ekspor tetap jalan memakai ringkasan ekstraktif.
GROQ_API_KEY=
